---
/**
 * Layout.astro — Root layout for all Verk pages.
 *
 * Responsibilities:
 *   - html lang attribute (Spanish primary)
 *   - SEO meta (title, description, OG, canonical)
 *   - Geist Mono CSS import (via @fontsource)
 *   - Global CSS import
 *   - Lenis smooth scroll initialization
 *   - Astro ViewTransitions
 *
 * doc 11 is the highest authority document.
 * No design decisions are made in this file.
 */

import { ClientRouter } from 'astro:transitions';
import '@fontsource/geist-mono/400.css';
import '@fontsource/geist-mono/500.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  noIndex?: boolean;
}

const {
  title,
  description = 'Verk es un estudio de infraestructura digital. Construimos los sistemas que conectan a tus clientes con tu negocio: sitios web, automatizaciones, integraciones CRM y herramientas con IA.',
  ogImage = '/images/logo.png',
  canonical,
  noIndex = false,
} = Astro.props;

const siteUrl = 'https://verk.mx';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).href;
const fullTitle = title === 'Verk' ? 'Verk — Infraestructura Digital' : `${title} — Verk`;
---

<!doctype html>
<html lang="es" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary meta -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, siteUrl).href} />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content="Verk" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, siteUrl).href} />

    <!-- Favicon (generated from the isotipo mark; replace with a designed
         SVG favicon when one is produced — see docs/production-checklist.md) -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Astro ViewTransitions (ClientRouter in Astro 5+) -->
    <ClientRouter />

    <!-- Remove no-js class once JS is available -->
    <script is:inline>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <slot />

    <!-- Lenis smooth scroll — loads after page content -->
    <script>
      import '../scripts/lenis';
    </script>
  </body>
</html>
