---
// Header flotante: píldora que lee la superficie bajo ella (transición cromática en degradado) y el isotipo oficial
// como único isotipo del header: indicador de progreso que se construye al recorrer el sitio. Estado en src/scripts/site/header.js.
import { ISOTIPO, WORDMARK } from './brand';
const links = [['#servicios', 'Servicios'], ['#metodo', 'Método'], ['#sistemas', 'Sistemas'], ['#contacto', 'Contacto']];
---
<header class="nav" data-nav-root>
  <div class="pill" data-pill data-v="cream">
    <span class="pill-bg" aria-hidden="true"></span>
    <a class="nav-mark" href="#top" aria-label="Verk — inicio"><svg viewBox="0 0 902 217" fill="currentColor" aria-hidden="true" set:html={WORDMARK} /></a>
    <span class="prog" aria-hidden="true">
      <span class="prog-mark"><svg class="prog-ghost" viewBox="0 0 567 739" set:html={ISOTIPO} /><svg class="prog-fill" viewBox="0 0 567 739" fill="currentColor" set:html={ISOTIPO} /></span>
      <span class="prog-k"><b data-num>01</b><i data-name>Inicio</i></span>
    </span>
    <nav class="nav-links" aria-label="Secciones">
      {links.map(([h, l]) => <a href={h}>{l}</a>)}
    </nav>
    <a class="btn nav-cta" href="#contacto">Auditoría</a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="menu">Menú</button>
  </div>
</header>
<div class="menu" id="menu" hidden>
  {links.map(([h, l]) => <a href={h}>{l}</a>)}
  <a class="btn btn-lime" href="#contacto">Solicitar auditoría</a>
</div>
