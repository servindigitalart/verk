---
import { ISOTIPO, WORDMARK } from './brand';
const year = new Date().getFullYear();
---
<footer class="site" data-surface="ink">
  <p class="sig">Seguimos construyendo<svg viewBox="0 0 567 739" fill="currentColor" aria-hidden="true" set:html={ISOTIPO} /></p>
  <p class="label muted">Conectamos. Automatizamos. Construimos.</p>
  <a class="wm" href="#top" aria-label="Verk — inicio"><svg viewBox="0 0 902 217" fill="currentColor" aria-hidden="true" set:html={WORDMARK} /></a>
  <p class="label copy">&copy; {year} Verk. Hecho con intención.</p>
</footer>
