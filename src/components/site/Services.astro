---
// Servicios · «Cuatro disciplinas. Un sistema.»
// Jerarquía: 1 contador de progreso · 2 un único isotipo protagonista · 3 título y disciplinas · 4 descripciones.
// El isotipo (src/scripts/site/services.js) se mueve de forma procedural y continua: solo traslación de sus barras por
// su eje de 45°, con una composición y un color que evolucionan con el progreso por las cuatro disciplinas.
// Sin JS / reduced-motion: estado final (cuatro disciplinas integradas), todo legible.
import { ISOTIPO } from './brand';
// [nombre, tramo del recorrido que cubre, descripción]
const services = [
  ['Sitios Web', 'La entrada', 'El primer punto de contacto entre tu negocio y tus clientes. Sitios diseñados para informar, generar confianza e iniciar conversaciones.'],
  ['Automatizaciones', 'La continuidad', 'Seguimientos, confirmaciones y recordatorios que ejecutan procesos definidos sin depender de que alguien tenga que recordarlos.'],
  ['Integraciones CRM', 'La conexión', 'Conectamos CRM, WhatsApp, formularios y calendario para organizar la información y mantener conectado el recorrido de cada cliente.'],
  ['Herramientas con IA', 'El criterio', 'Combinamos asistentes, agentes, modelos de IA y automatizaciones para crear herramientas adaptadas al contexto y los procesos de tu negocio.'],
];
---
<section class="sec svc-sec" id="servicios" data-surface="violet" data-svc data-k="4" aria-labelledby="t-svc">
  <div class="svc-stage" aria-hidden="true">
    <p class="svc-now"><b class="svc-n">04</b><span class="label">/ 04</span></p>
    <svg class="svc-mark" viewBox="0 0 567 739" fill="currentColor" set:html={ISOTIPO} />
    <span class="svc-track"><i></i></span>
  </div>
  <div class="svc-main">
    <p class="label">03 · Lo que construimos</p>
    <h2 class="h2 svc-title" id="t-svc"><span>Cuatro disciplinas.</span> <span class="svc-t2"><span>Un sistema.</span></span></h2>
    <p class="lead">Cada disciplina cubre una parte del recorrido de tus clientes. Las conectamos según lo que tu operación necesita.</p>
    <ol class="svc-rows">
      {services.map(([name, part, body], i) => (
        <li class="svc" data-i={i}>
          <span class="svc-num">{String(i + 1).padStart(2, '0')}</span>
          <h3>{name}</h3>
          <span class="svc-part label">{part}</span>
          <p>{body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
