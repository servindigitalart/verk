---
import { ICON } from '../../scripts/site/icons.js';
import { ISOTIPO } from './brand';
// Copy de los pasos: aprobado el 2026-11-06 (docs/homepage-copy-proposals.md). Cotas técnicas: F2/F3. La línea es la protagonista (method-route.js).
const steps = [
  ['01', 'alcance', 'Entendemos', 'Analizamos cómo funciona tu operación, dónde están los problemas y qué necesitas conectar.'],
  ['02', 'prototipo', 'Diseñamos', 'Definimos el sistema y sus conexiones antes de empezar a construir.'],
  ['03', 'sistema en producción', 'Construimos', 'Desarrollamos el sitio, las automatizaciones y las integraciones que necesita tu operación.'],
  ['04', 'QA: Lighthouse · axe · Playwright', 'Verificamos', 'Probamos cada flujo y conexión para comprobar que funciona como fue diseñado.'],
];
---
<section class="sec" id="metodo" data-surface="cream-warm" aria-labelledby="t-met">
  <p class="label muted">04 · Cómo funciona</p>
  <h2 class="h2" id="t-met">El orden importa.</h2>
  <p class="lead">Primero entendemos cómo funciona tu operación. Después diseñamos, construimos y verificamos el sistema.</p>
  <div class="steps-wrap">
  <ol class="steps">
    {steps.map(([n, cota, name, body]) => (
      <li class="step"><span class="node" aria-hidden="true"></span><span class="spark" aria-hidden="true"></span><span class="cota">{n} <i set:html={ICON['→']} /> {cota}</span><b>{name}</b><span>{body}</span></li>
    ))}
  </ol>
  <svg class="steps-end" viewBox="0 0 567 739" fill="currentColor" aria-hidden="true" set:html={ISOTIPO} />
  </div>
</section>
