---
/**
 * Services.astro — Phase 5
 *
 * Retired the four-row grid (docs/18 Part 6: "no quiero cuatro filas, quiero
 * un sistema"). Replaced with an editorial índice — the typographic device
 * of a printed table of contents (name — leader dots — the next name) —
 * followed by one continuous column, each discipline reduced to a small
 * running-head marginalia instead of a repeated bold title. The visual
 * weight of "the name" lives once, in the index; the body reads as a
 * single article, not four cards.
 *
 * Surface: --color-cream-warm (docs/18 Part 2) — the second light chapter,
 * related to the Hero's cream but not identical to it.
 *
 * IA keeps its dark inset + violet pill (doc 11 law: violet = intelligence
 * only) — now an interruption inside a running column, not a fourth
 * identical row with a different fill.
 */

const disciplines = [
  {
    id: 'svc-sitios',
    name: 'Sitios Web',
    body: 'Tu sitio web no es una vitrina. Es el primer paso de un sistema que convierte visitas en conversaciones reales.',
  },
  {
    id: 'svc-auto',
    name: 'Automatizaciones',
    body: 'Cada tarea que se repite puede automatizarse. Construimos los flujos que ejecutan seguimientos, confirmaciones y recordatorios sin intervención.',
  },
  {
    id: 'svc-crm',
    name: 'Integraciones CRM',
    body: 'Cuando tus herramientas no hablan entre sí, los clientes potenciales se pierden. Conectamos CRM, WhatsApp, formularios y calendario para que nada quede sin respuesta.',
  },
];
---

<section class="services section section-light" id="servicios" aria-label="Servicios" data-theme="light">

  <div class="container services-container">

    <header class="services-header">
      <p class="text-label services-lbl">Servicios</p>
      <h2 class="services-headline">
        <span class="services-line">Cuatro disciplinas.</span>
        <span class="services-line">Un sistema.</span>
      </h2>
      <p class="services-intro">
        No servicios sueltos. Todo lo que construimos está diseñado para conectarse.
      </p>
    </header>

    <!-- Índice — the table-of-contents gesture. Leader dots fill the gap
         between names the way a printed index fills the gap before a
         page number — except there is no page number, only air. -->
    <nav class="services-index" aria-label="Índice de disciplinas">
      {disciplines.map((d) => (
        <>
          <a href={`#${d.id}`} class="index-item">{d.name}</a>
          <span class="index-dots" aria-hidden="true"></span>
        </>
      ))}
      <a href="#svc-ia" class="index-item index-item--ia" data-cursor-tone="intel">Herramientas IA</a>
    </nav>

    <!-- One continuous editorial column — not four boxed rows -->
    <div class="services-column">
      {disciplines.map((d) => (
        <article class="service-entry" id={d.id}>
          <p class="service-runninghead text-mono">{d.name}</p>
          <p class="service-body">{d.body}</p>
        </article>
      ))}

      <!-- IA — the interruption. Same column, different material. -->
      <article class="service-entry service-entry--ia" id="svc-ia">
        <span class="pill pill-violet ia-pill" aria-label="Inteligencia artificial">Inteligencia</span>
        <p class="service-runninghead text-mono service-runninghead--ia">Herramientas con IA</p>
        <p class="service-body service-body--ia">
          Las herramientas de IA genéricas no conocen tu negocio. Construimos las tuyas: entrenadas en tu operación, útiles desde el primer día.
        </p>
      </article>
    </div>

  </div>
</section>

<style>
  /* ── Section — cream-warm surface, distinct from the Hero's cream ──── */

  .services {
    background-color: var(--color-cream-warm);
    overflow: hidden;
  }

  .services-container {
    position: relative;
    z-index: 1;
  }

  /* ── Header ─────────────────────────────────────────────────── */

  .services-header {
    max-width: 600px;
    margin-bottom: var(--space-12);
  }

  .services-lbl {
    display: block;
    margin-bottom: var(--space-5);
  }

  .services-headline {
    margin: 0 0 var(--space-8);
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
  }

  .services-line {
    display: block;
    font-size: clamp(2.25rem, 1.2rem + 4.5vw, 5.5rem);
  }

  .services-intro {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-grey-mid);
    margin: 0;
    max-width: 480px;
  }

  /* ── Índice — the table-of-contents gesture ──────────────────── */

  .services-index {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
    padding-block: var(--space-10);
    margin-bottom: var(--space-4);
    border-top: 1px solid var(--color-border-medium);
    border-bottom: 1px solid var(--color-border-medium);
  }

  .index-item {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: clamp(1.25rem, 0.95rem + 1.4vw, 2rem);
    letter-spacing: var(--tracking-snug);
    color: var(--color-ink);
    white-space: nowrap;
    transition: color var(--duration-fast) var(--ease-out-expo);
  }

  .index-item--ia {
    color: var(--color-violet);
  }

  @media (hover: hover) and (pointer: fine) {
    .index-item:hover {
      color: var(--color-grey-mid);
    }

    .index-item--ia:hover {
      color: var(--color-ink);
    }
  }

  /* The leader — a responsive dotted rule filling whatever space is left,
     exactly the way a printed index leads a title to its page number. */
  .index-dots {
    flex: 1 1 32px;
    min-width: 20px;
    height: 0;
    align-self: center;
    border-bottom: 2px dotted var(--color-border-medium);
  }

  /* ── Continuous column ────────────────────────────────────────── */

  .services-column {
    display: flex;
    flex-direction: column;
  }

  .service-entry {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: var(--space-8);
    padding-block: var(--space-8);
    border-top: 1px solid var(--color-border-light);
    align-items: baseline;
  }

  .service-entry:first-child {
    border-top: none;
  }

  .service-runninghead {
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    font-size: var(--text-2xs);
    color: var(--color-grey-soft);
    margin: 0;
  }

  .service-body {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-grey-mid);
    margin: 0;
    max-width: 58ch;
  }

  /* ── IA entry — dark inset, the column's one interruption ────── */

  .service-entry--ia {
    background-color: var(--color-surface-dark);
    border-top: none;
    border-radius: var(--radius-lg);
    grid-template-columns: 160px 1fr;
    margin-top: var(--space-4);
    padding: var(--space-8);
  }

  .service-entry--ia .ia-pill {
    grid-column: 1 / -1;
    justify-self: start;
    margin-bottom: var(--space-1);
  }

  .service-runninghead--ia {
    color: var(--color-grey-dim-dark);
  }

  .service-body--ia {
    color: var(--color-grey-mid-dark);
  }

  /* ── Mobile — 768px and below ─────────────────────────────────── */

  @media (max-width: 768px) {
    .services-index {
      padding-block: var(--space-6);
    }

    .service-entry,
    .service-entry--ia {
      grid-template-columns: 1fr;
      gap: var(--space-3);
      padding-block: var(--space-6);
    }

    .service-entry--ia {
      padding: var(--space-6);
    }

    .service-entry--ia .ia-pill {
      grid-column: auto;
    }

    .services-intro {
      max-width: 100%;
    }
  }
</style>
