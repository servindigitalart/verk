---
/**
 * Services.astro — Phase 5.2 "Color Rhythm"
 *
 * Composition unchanged from 5.1 (the staggered numeral cascade — kept
 * per instruction not to touch structure/components). What changes here
 * is purely the chapter's atmosphere: Servicios becomes the site's first
 * dark chapter — near-black surface, violet as its one accent (the IA
 * numeral, already violet, is now the section's whole color identity,
 * not a special case within it). This is what actually answers "cada
 * sección debe sentirse como un nuevo capítulo" — alternating cream and
 * near-black instead of cream and cream-warm.
 *
 * Header: data-theme="violet" — Nav.astro inverts its pill to cream and
 * tints its edge violet for this chapter (shared with Sistemas, the
 * other violet-accent chapter).
 */

const disciplines = [
  {
    id: 'svc-sitios',
    num: '01',
    name: 'Sitios Web',
    body: 'Tu sitio web no es una vitrina. Es el primer paso de un sistema que convierte visitas en conversaciones reales.',
  },
  {
    id: 'svc-auto',
    num: '02',
    name: 'Automatizaciones',
    body: 'Cada tarea que se repite puede automatizarse. Construimos los flujos que ejecutan seguimientos, confirmaciones y recordatorios sin intervención.',
  },
  {
    id: 'svc-crm',
    num: '03',
    name: 'Integraciones CRM',
    body: 'Cuando tus herramientas no hablan entre sí, los clientes potenciales se pierden. Conectamos CRM, WhatsApp, formularios y calendario para que nada quede sin respuesta.',
  },
  {
    id: 'svc-ia',
    num: '04',
    name: 'Herramientas con IA',
    body: 'Las herramientas de IA genéricas no conocen tu negocio. Construimos las tuyas: entrenadas en tu operación, útiles desde el primer día.',
    isIA: true,
  },
];
---

<section class="services section section-dark" id="servicios" aria-label="Servicios" data-theme="violet">

  <div class="container services-container">

    <header class="services-header" data-reveal>
      <p class="text-label services-lbl">Servicios</p>
      <h2 class="services-headline">
        <span class="services-line">Cuatro disciplinas.</span>
        <span class="services-line">Un sistema.</span>
      </h2>
      <p class="services-intro">
        No servicios sueltos. Todo lo que construimos está diseñado para conectarse.
      </p>
    </header>

    <!-- Staggered cascade — one shared treatment for all four; IA differs
         only by the color of its numeral, nothing structural. -->
    <div class="disciplines">
      {disciplines.map((d, i) => (
        <div
          class:list={['discipline', `discipline-${i + 1}`]}
          data-reveal
          data-reveal-delay={i * 100}
        >
          <span
            class:list={['discipline-num', 'text-mono', d.isIA && 'discipline-num--ia']}
            aria-hidden="true"
          >
            {d.num}
          </span>
          <details class="discipline-detail" id={d.id}>
            <summary
              class:list={['discipline-name', d.isIA && 'discipline-name--ia']}
              data-cursor-tone={d.isIA ? 'intel' : 'default'}
            >
              {d.name}
            </summary>
            <p class="discipline-body">{d.body}</p>
          </details>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  /* ── Section — near-black, this chapter's whole atmosphere ───── */

  .services {
    overflow: hidden;
  }

  .services-container {
    position: relative;
    z-index: 1;
  }

  /* ── Header ─────────────────────────────────────────────────── */

  .services-header {
    max-width: 600px;
    margin-bottom: var(--space-20);
  }

  .services-lbl {
    display: block;
    margin-bottom: var(--space-5);
  }

  .services-headline {
    margin: 0 0 var(--space-8);
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--color-cream);
  }

  .services-line {
    display: block;
    font-size: clamp(2.25rem, 1.2rem + 4.5vw, 5.5rem);
  }

  .services-intro {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-grey-mid-dark);
    margin: 0;
    max-width: 480px;
  }

  /* ── The cascade ────────────────────────────────────────────── */
  /*
   * Each entry steps further right and slightly further down than the
   * last — a poster/title-sequence rhythm. Values are deliberate, not
   * arbitrary: the offset increases monotonically so the eye reads the
   * four in order without needing a connecting line or number-of-four
   * label anywhere.
   */

  .disciplines {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .discipline {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: var(--space-5);
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-border-dark);
  }

  .discipline-1 { padding-left: 0; }
  .discipline-2 { padding-left: 6%; }
  .discipline-3 { padding-left: 13%; }
  .discipline-4 { padding-left: 4%; border-bottom: 1px solid var(--color-border-dark); }

  .discipline-num {
    flex-shrink: 0;
    font-size: clamp(1.25rem, 0.9rem + 1.5vw, 2rem);
    font-weight: var(--weight-medium);
    color: var(--color-grey-dim-dark);
    line-height: 1;
  }

  .discipline-num--ia {
    color: var(--color-violet);
  }

  .discipline-detail {
    min-width: 0;
  }

  .discipline-name {
    display: block;
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: clamp(1.75rem, 1.1rem + 3vw, 3.5rem);
    letter-spacing: var(--tracking-snug);
    line-height: 1.1;
    color: var(--color-cream);
    cursor: pointer;
    list-style: none;
    transition: color var(--duration-fast) var(--ease-out-expo);
  }

  .discipline-name::-webkit-details-marker {
    display: none;
  }

  .discipline-name::after {
    content: '+';
    display: inline-block;
    margin-left: var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.4em;
    vertical-align: middle;
    color: var(--color-grey-dim-dark);
    transition: transform var(--duration-normal) var(--ease-out-expo);
  }

  details[open] .discipline-name::after {
    transform: rotate(135deg);
  }

  .discipline-name--ia::after {
    color: var(--color-violet);
  }

  @media (hover: hover) and (pointer: fine) {
    .discipline-name:hover {
      color: var(--color-grey-mid-dark);
    }
  }

  .discipline-body {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-grey-mid-dark);
    max-width: 58ch;
    margin: var(--space-4) 0 0;
  }

  /* ── Mobile — 768px and below ─────────────────────────────────── */
  /*
   * Phase 6 mobile audit, finding 4: this used to reset every offset to
   * 0 — the cascade (the section's whole reason for not being "four
   * rows") disappeared completely, leaving an unstaggered list
   * indistinguishable from the pre-Phase-5 grid. Fixed with fixed-px
   * offsets (not percentages) scaled for a narrow column: small enough
   * that "Automatizaciones"/"Herramientas con IA" never risk an awkward
   * wrap at 320–430px, present enough that the eye still reads a
   * staircase, not a list. Vertical padding also increases slightly
   * per step (space-5 → space-6) so the cascade reads in the vertical
   * rhythm too, not just the horizontal one.
   */

  @media (max-width: 768px) {
    .discipline {
      gap: var(--space-3);
      padding-block: var(--space-5);
    }

    .discipline-1 { padding-left: 0; }
    .discipline-2 { padding-left: 14px; padding-block: var(--space-6); }
    .discipline-3 { padding-left: 26px; }
    .discipline-4 { padding-left: 8px; padding-block: var(--space-6); }

    .discipline-num {
      font-size: 1.125rem;
    }

    .services-intro {
      max-width: 100%;
    }
  }
</style>
