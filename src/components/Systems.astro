---

<section class="systems section section-light" id="proyectos" aria-label="Sistemas" data-theme="light">

  <div class="container systems-container">

    <header class="systems-header" data-reveal>
      <p class="text-label systems-lbl">Sistemas</p>
      <h2 class="systems-headline">
        <span class="systems-line">El problema cambia.</span>
        <span class="systems-line">El método no.</span>
      </h2>
      <p class="systems-intro">
        Seis capacidades. Diez sistemas como evidencia. Cada capítulo demuestra una
        forma distinta de resolver problemas — no un formato de proyecto distinto.
      </p>
    </header>

    <div class="chapters">
      {chapters.map((chapter) => (
        <div class:list={['chapter', `chapter--${chapter.layout}`]} data-reveal>
          <header class="chapter-head">
            <p class="chapter-num text-mono">{chapter.label}</p>
            <p class="chapter-thesis">{chapter.thesis}</p>
          </header>

          <div class="chapter-body">
            <SystemEntry {...chapter.anchor} />
            {chapter.support.map((s) => (
              <SystemEntry {...s} />
            ))}
          </div>

          {chapter.quietNote && (
            <p class="chapter-quiet-note text-mono">{chapter.quietNote}</p>
          )}
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .systems {
    overflow: hidden;
  }

  .systems-container {
    position: relative;
    z-index: 1;
  }

  .systems-header {
    max-width: 640px;
    margin-bottom: var(--space-20);
  }

  .systems-lbl {
    display: block;
    margin-bottom: var(--space-5);
  }

  .systems-headline {
    margin: 0 0 var(--space-8);
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
  }

  .systems-line {
    display: block;
    font-size: clamp(2.25rem, 1.2rem + 4.5vw, 5.5rem);
  }

  .systems-intro {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-grey-mid);
    margin: 0;
    max-width: 520px;
  }

  /* ── Chapters ───────────────────────────────────────────────── */

  .chapters {
    display: flex;
    flex-direction: column;
    gap: var(--space-32);
  }

  .chapter-head {
    max-width: 720px;
    margin-bottom: var(--space-10);
  }

  .chapter-num {
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    font-size: var(--text-2xs);
    color: var(--color-grey-soft);
    margin: 0 0 var(--space-4);
  }

  .chapter-thesis {
    font-family: var(--font-display);
    font-weight: var(--weight-medium);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-snug);
    color: var(--color-ink);
    margin: 0;
  }

  .chapter-body :global(.system-entry) {
    border-top: 1px solid var(--color-border-medium);
  }

  /* ── Chapter 01 — feature-dark: unchanged Sonoro treatment ───── */

  .chapter--feature-dark .chapter-body :global(.system-entry) {
    border-top: none;
  }

  /* ── Chapter 02 — feature-quiet: generous air, one whisper of detail ── */

  .chapter--feature-quiet .chapter-body {
    padding-block: var(--space-8);
  }

  .chapter-quiet-note {
    margin-top: var(--space-6);
    text-align: right;
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wide);
    color: var(--color-grey-light);
  }

  /* ── Chapter 03 — diagram: anchor + a footnote-like callout ──── */

  .chapter--diagram .chapter-body {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: var(--space-12);
    align-items: start;
  }

  .chapter--diagram .chapter-body :global(.system-entry:nth-child(2)) {
    border-top: none;
    border-left: 1px solid var(--color-border-medium);
    padding-left: var(--space-8);
    padding-top: 0;
  }

  /* ── Chapter 04 — diptych: two full peers, side by side ──────── */

  .chapter--diptych .chapter-body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
  }

  .chapter--diptych .chapter-body :global(.system-entry:nth-child(2)) {
    border-top: 1px solid var(--color-border-medium);
    padding-left: var(--space-12);
    border-left: 1px solid var(--color-border-medium);
  }

  /* ── Chapter 05 — poster: three compact entries, tighter rhythm ── */

  .chapter--poster .chapter-body {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-10);
  }

  .chapter--poster .chapter-body :global(.system-entry) {
    padding-block: var(--space-6);
  }

  .chapter--poster .chapter-body :global(.system-entry:not(:first-child)) {
    border-top: 1px solid var(--color-border-medium);
    padding-left: var(--space-8);
    border-left: 1px solid var(--color-border-medium);
  }

  /* ── Chapter 06 — feature-calm: the closing argument, at rest ─── */

  .chapter--feature-calm .chapter-body {
    background-color: var(--color-cream-warm);
    border-radius: var(--radius-xl);
    padding: var(--space-12);
  }

  .chapter--feature-calm .chapter-body :global(.system-entry) {
    border-top: none;
  }

  /* ── Mobile — every chapter collapses to one column ──────────── */

  @media (max-width: 900px) {
    .chapters {
      gap: var(--space-20);
    }

    .chapter--diagram .chapter-body,
    .chapter--diptych .chapter-body,
    .chapter--poster .chapter-body {
      grid-template-columns: 1fr;
    }

    .chapter--diagram .chapter-body :global(.system-entry:nth-child(2)),
    .chapter--diptych .chapter-body :global(.system-entry:nth-child(2)),
    .chapter--poster .chapter-body :global(.system-entry:not(:first-child)) {
      border-left: none;
      padding-left: 0;
      border-top: 1px solid var(--color-border-medium);
      padding-top: var(--space-6);
    }

    .chapter--feature-calm .chapter-body {
      padding: var(--space-8);
    }

    .chapter-thesis {
      font-size: var(--text-lg);
    }
  }
</style>
