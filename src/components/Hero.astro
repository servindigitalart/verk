---
/**
 * Hero.astro — Concept 4: "La Primera Decisión"
 * Phase 2A implementation. doc 11 is highest authority.
 *
 * Concept:
 *   Almost empty. An expanse of cream. The isotipo already present,
 *   as if it has been there for some time. The headline arrives one
 *   line at a time at reading speed. The subheadline follows. Then
 *   the CTAs. Then the microcopy. Nothing simultaneous. Nothing rushed.
 *
 * Copy source: doc 12, Part 9 (Final Hero Copy Lock)
 *   Headline:    Construimos sistemas. / No sitios.
 *   Subheadline: De la primera visita al cliente que paga…
 *   Primary CTA: Ver cómo funciona
 *   Secondary:   Ver proyectos
 *   Microcopy:   Para clínicas, despachos y negocios…
 *
 * Motion:
 *   CSS-only sequential reveal — no JS, no animation libraries.
 *   animation-fill-mode: both keeps elements invisible before their
 *   delay fires and visible after the animation completes.
 *
 *   Timing (reading speed, not animation speed):
 *     Label    → delay 0.3s, duration 0.4s
 *     Line 1   → delay 1.0s, duration 0.55s
 *     Line 2   → delay 2.6s, duration 0.55s  (1.2s pause after line 1)
 *     Sub      → delay 4.2s, duration 0.55s  (1.0s pause after line 2)
 *     Actions  → delay 5.5s, duration 0.50s  (0.75s pause after sub)
 *     Microcopy→ delay 6.5s, duration 0.40s  (0.5s pause after actions)
 *
 *   Each transition: opacity 0→1 + translateY(28px)→0, ease-out-expo.
 *
 * Isotipo:
 *   Position: absolute, right side, vertically centered on the hero.
 *   Opacity: 0.08 (8%, per doc 11).
 *   No entrance animation — it exists before the user arrives.
 *   mix-blend-mode: multiply makes any white background transparent
 *   against the cream hero surface.
 */
---

<section class="hero" aria-label="Inicio" id="inicio">

  <!--
    Isotipo — decorative background element.
    Already present. No entrance. No animation.
    Rule: aria-hidden on all decorative elements.
  -->
  <div class="hero-isotipo" aria-hidden="true">
    <img
      src="/images/isotipo.png"
      alt=""
      width="700"
      height="700"
      draggable="false"
      fetchpriority="high"
      decoding="async"
    />
  </div>

  <!-- Content — sequential reveal -->
  <div class="hero-content">

    <!--
      Section label — Rule 6 (doc 11): every section begins with a
      label above the headline, never directly with the headline.
    -->
    <p class="hero-label text-label">
      Infraestructura Digital
    </p>

    <!--
      Primary headline — two discrete lines.
      Each span is display:block so they stack as separate lines
      and can animate independently at their own delay.
      No <br> — the spans control the line break structurally.
    -->
    <h1 class="hero-headline">
      <span class="hero-line hero-line-1">Construimos sistemas.</span>
      <span class="hero-line hero-line-2">No sitios.</span>
    </h1>

    <!-- Subheadline — one thought, no line breaks forced on desktop -->
    <p class="hero-sub">
      De la primera visita al cliente que paga: sin
      seguimiento manual, sin leads perdidos, sin plantillas.
    </p>

    <!-- CTA group — primary lime + secondary ghost -->
    <div class="hero-actions" role="group" aria-label="Acciones principales">
      <a href="#servicios" class="btn btn-primary hero-btn-primary">
        Ver cómo funciona
      </a>
      <a href="#proyectos" class="hero-btn-secondary">
        Ver proyectos
        <svg class="hero-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

    <!-- Microcopy — audience qualifier -->
    <p class="hero-microcopy">
      Para clínicas, despachos y negocios que han superado las plantillas.
    </p>

  </div>

</section>

<style>
  /* ─── Keyframe ────────────────────────────────────────────── */
  /*
   * Single keyframe used by all hero content elements.
   * Named heroReveal to avoid collision with global fadeUp.
   * 28px entrance offset (slightly smaller than the global 32px
   * to match the delicate pacing of this concept).
   */
  @keyframes heroReveal {
    from {
      opacity: 0;
      transform: translateY(28px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ─── Section ─────────────────────────────────────────────── */

  .hero {
    position: relative;
    min-height: 100svh;
    background-color: var(--color-cream);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-block: clamp(80px, 10vw, 140px);
    padding-inline: clamp(24px, 5vw, 80px);
    overflow: hidden;
  }

  /* ─── Isotipo ─────────────────────────────────────────────── */
  /*
   * Absolutely positioned in the right portion of the hero.
   * Large enough to create presence behind the text without
   * overpowering the cream surface.
   *
   * mix-blend-mode: multiply ensures any white areas of the PNG
   * become transparent against the cream background, revealing
   * only the violet shape geometry.
   *
   * No transition, no animation — it is always here.
   */
  .hero-isotipo {
    position: absolute;
    right: -6%;
    top: 50%;
    transform: translateY(-50%);
    width: clamp(340px, 50vw, 720px);
    pointer-events: none;
    user-select: none;
    opacity: 0.08;
  }

  .hero-isotipo img {
    display: block;
    width: 100%;
    height: auto;
    mix-blend-mode: multiply;
  }

  /* ─── Content ─────────────────────────────────────────────── */

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 900px;
  }

  /* ─── Label ───────────────────────────────────────────────── */

  .hero-label {
    display: block;
    margin-bottom: var(--space-8);

    animation-name: heroReveal;
    animation-duration: 0.4s;
    animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    animation-fill-mode: both;
    animation-delay: 0.3s;
  }

  /* ─── Headline ────────────────────────────────────────────── */

  .hero-headline {
    display: block;
    margin: 0;
    margin-bottom: var(--space-10);
    /* Prevent browser from adding default h1 margins */
    padding: 0;
  }

  .hero-line {
    display: block;
    font-family: var(--font-display);
    /*
     * Fluid scale: 3.5rem at mobile → 8rem at wide desktop.
     * Tight tracking (-0.04em) per doc 11 Part 6.
     * Line-height 1.0 for maximum density at display scale.
     */
    font-size: clamp(3.25rem, 1.5rem + 7vw, 8rem);
    font-weight: 700;
    line-height: 1.0;
    letter-spacing: -0.04em;
    color: var(--color-ink);

    animation-name: heroReveal;
    animation-duration: 0.55s;
    animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    animation-fill-mode: both;
  }

  .hero-line-1 {
    animation-delay: 1.0s;
  }

  /* "No sitios." — shorter line, arrives after 1.2s reading pause */
  .hero-line-2 {
    animation-delay: 2.6s;
    /*
     * The second line is intentionally shorter.
     * At desktop, "No sitios." will occupy roughly 40% of the
     * width of "Construimos sistemas." — the asymmetry is compositional.
     */
  }

  /* ─── Subheadline ─────────────────────────────────────────── */

  .hero-sub {
    font-family: var(--font-body);
    font-size: clamp(1rem, 0.85rem + 0.6vw, 1.2rem);
    font-weight: var(--weight-regular);
    line-height: 1.65;
    color: var(--color-grey-mid);
    max-width: 560px;
    margin: 0;
    margin-bottom: var(--space-10);

    animation-name: heroReveal;
    animation-duration: 0.55s;
    animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    animation-fill-mode: both;
    animation-delay: 4.2s;
  }

  /* ─── Actions ─────────────────────────────────────────────── */

  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: wrap;
    margin-bottom: var(--space-6);

    animation-name: heroReveal;
    animation-duration: 0.5s;
    animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    animation-fill-mode: both;
    animation-delay: 5.5s;
  }

  /* Primary — lime pill, slightly larger than the global .btn default */
  .hero-btn-primary {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: 0.01em;
    color: var(--color-ink);
    background-color: var(--color-lime);
    border-radius: var(--radius-full);
    padding: 14px 28px;
    line-height: 1;
    white-space: nowrap;
    transition:
      background-color 150ms ease,
      transform        100ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .hero-btn-primary:hover {
      background-color: #CEFF00;
    }
  }

  .hero-btn-primary:active {
    transform: scale(0.97);
  }

  /* Secondary — text link with animated arrow gap */
  .hero-btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-regular);
    color: var(--color-grey-soft);
    padding: 14px 0;
    line-height: 1;
    transition:
      color 150ms ease,
      gap   300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    .hero-btn-secondary:hover {
      color: var(--color-ink);
      gap: var(--space-4);
    }

    .hero-btn-secondary:hover .hero-arrow {
      transform: translateX(3px);
    }
  }

  .hero-arrow {
    flex-shrink: 0;
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* ─── Microcopy ───────────────────────────────────────────── */

  .hero-microcopy {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: var(--weight-regular);
    line-height: 1.5;
    color: var(--color-grey-soft);
    letter-spacing: 0.01em;

    animation-name: heroReveal;
    animation-duration: 0.4s;
    animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    animation-fill-mode: both;
    animation-delay: 6.5s;
  }

  /* ─── Tablet ──────────────────────────────────────────────── */

  @media (max-width: 900px) {
    .hero-isotipo {
      right: -15%;
      width: clamp(280px, 65vw, 500px);
      opacity: 0.06;
    }
  }

  /* ─── Mobile ──────────────────────────────────────────────── */
  /*
   * Mobile is not a reduced version — it's a first-class experience.
   * Typography remains large and impactful.
   * The isotipo shifts to be centered rather than right-anchored.
   */
  @media (max-width: 600px) {
    .hero {
      padding-block: clamp(100px, 20vw, 140px) clamp(60px, 10vw, 100px);
    }

    .hero-isotipo {
      right: 50%;
      transform: translateX(50%) translateY(-55%);
      width: 85vw;
      opacity: 0.05;
    }

    .hero-sub {
      max-width: 100%;
    }

    .hero-actions {
      gap: var(--space-4);
    }

    .hero-btn-primary {
      padding: 13px 24px;
    }
  }

  /* ─── Reduced motion ──────────────────────────────────────── */
  /*
   * When prefers-reduced-motion is set:
   *   1. Remove all animations entirely (not just shorten them)
   *   2. Explicitly set opacity:1 so elements are immediately visible
   *
   * Note: the global motion.css sets animation-duration: 0.01ms !important
   * but does NOT handle the case where animation-delay is still 6.5s,
   * which would leave elements invisible for that duration.
   * This explicit override prevents that.
   */
  @media (prefers-reduced-motion: reduce) {
    .hero-label,
    .hero-line,
    .hero-sub,
    .hero-actions,
    .hero-microcopy {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
