---
/**
 * Hero.astro — Concept 4: "La Primera Decisión" + Phase 5 visual component
 * doc 11 is highest authority for copy/hierarchy. Phase 5 (docs/18, docs/19)
 * replaces the isotipo-watermark with a different question entirely: not
 * "how do I draw the mark" but "what should someone feel in the first five
 * seconds." The answer here is restraint that resolves — nothing happens
 * in the negative space until the reading is done, and then exactly one
 * quiet, permanent mark appears: a single hairline with two angled ticks
 * at its ends (the isotipo's own diagonal, quoted, not drawn) — evidence
 * that even the empty space was measured, not left over.
 *
 * Copy source: doc 12, Part 9 (Final Hero Copy Lock) — unchanged.
 *
 * Motion — compressed per docs/18 Part 4.2 (microcopy now lands at 5.4s,
 * not 6.5s) — still reading speed, not animation speed:
 *   Label    → delay 0.3s,  duration 0.4s
 *   Line 1   → delay 1.0s,  duration 0.55s
 *   Line 2   → delay 2.3s,  duration 0.55s
 *   Sub      → delay 3.6s,  duration 0.55s
 *   Actions  → delay 4.7s,  duration 0.50s
 *   Microcopy→ delay 5.4s,  duration 0.40s
 *   Mark     → delay 5.6s,  duration 0.9s  (the last event — arrives after
 *                                           everything else has landed)
 */
---

<section class="hero" aria-label="Inicio" id="inicio" data-theme="light">

  <!--
    The hairline mark — the only thing that lives in the negative space
    now. Static once drawn: doc 18 Part 5, "el cruce" was retired in favor
    of something quieter. Two ticks quote the isotipo's angle without
    being the isotipo — a measurement, not a logo placement.
  -->
  <div class="hero-mark" aria-hidden="true">
    <span class="hero-mark-tick hero-mark-tick-top"></span>
    <span class="hero-mark-line"></span>
    <span class="hero-mark-tick hero-mark-tick-bottom"></span>
  </div>

  <!-- Content — sequential reveal -->
  <div class="hero-content">

    <!--
      Section label — Rule 6 (doc 11): every section begins with a
      label above the headline, never directly with the headline.
    -->
    <p class="hero-label text-label">
      Infraestructura Digital
    </p>

    <!--
      Primary headline — two discrete lines.
      Each span is display:block so they stack as separate lines
      and can animate independently at their own delay.
      No <br> — the spans control the line break structurally.
    -->
    <h1 class="hero-headline">
      <span class="hero-line hero-line-1">Construimos sistemas.</span>
      <span class="hero-line hero-line-2">No sitios.</span>
    </h1>

    <!-- Subheadline — one thought, no line breaks forced on desktop -->
    <p class="hero-sub">
      De la primera visita al cliente que paga: sin
      seguimiento manual, sin leads perdidos, sin plantillas.
    </p>

    <!-- CTA group — primary lime + secondary ghost -->
    <div class="hero-actions" role="group" aria-label="Acciones principales">
      <a href="#servicios" class="btn btn-primary hero-btn-primary" data-cursor-tone="action">
        Ver cómo funciona
      </a>
      <a href="#proyectos" class="hero-btn-secondary">
        Ver proyectos
        <svg class="hero-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

    <!-- Microcopy — audience qualifier -->
    <p class="hero-microcopy">
      Para clínicas, despachos y negocios que han superado las plantillas.
    </p>

  </div>

</section>

<style>
  /* ─── Keyframe ────────────────────────────────────────────── */
  /*
   * Single keyframe used by all hero content elements.
   * Named heroReveal to avoid collision with global fadeUp.
   * 28px entrance offset (slightly smaller than the global 32px
   * to match the delicate pacing of this concept).
   */
  @keyframes heroReveal {
    from {
      opacity: 0;
      transform: translateY(28px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ─── Section ─────────────────────────────────────────────── */

  .hero {
    position: relative;
    min-height: 100svh;
    background-color: var(--color-cream);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-block: clamp(80px, 10vw, 140px);
    padding-inline: clamp(24px, 5vw, 80px);
    overflow: hidden;
  }

  /* ─── The mark ────────────────────────────────────────────── */
  /*
   * Phase 5 (docs/18, docs/19). Not the isotipo, not a watermark — a
   * single hairline with two ticks at its own angle, quoting the mark's
   * geometry without placing the logo in the background. Lives at the
   * right edge, in the space the isotipo used to occupy. Static once
   * drawn: it is the last event of the sequence, not a loop.
   */
  .hero-mark {
    position: absolute;
    right: clamp(28px, 7vw, 110px);
    top: 14%;
    bottom: 16%;
    width: 1px;
    pointer-events: none;
    user-select: none;
  }

  .hero-mark-line {
    position: absolute;
    inset: 0;
    background-color: var(--color-border-medium);
    transform-origin: top;
    transform: scaleY(0);
    animation: heroMarkDraw 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: 5.6s;
  }

  .hero-mark-tick {
    position: absolute;
    left: -3px;
    width: 7px;
    height: 1px;
    background-color: var(--color-grey-light);
    opacity: 0;
    animation: heroTickReveal 0.4s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .hero-mark-tick-top {
    top: 0;
    animation-delay: 5.6s;
  }

  .hero-mark-tick-bottom {
    bottom: 0;
    animation-delay: 6.3s;
  }

  @keyframes heroMarkDraw {
    from { transform: scaleY(0); }
    to   { transform: scaleY(1); }
  }

  /* Same diagonal as the isotipo's own angle — a quote, not the mark itself */
  @keyframes heroTickReveal {
    from { opacity: 0; transform: rotate(-24deg) translateX(-5px); }
    to   { opacity: 1; transform: rotate(-24deg) translateX(0); }
  }

  /* ─── Content ─────────────────────────────────────────────── */

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 900px;
  }

  /* ─── Label ───────────────────────────────────────────────── */

  .hero-label {
    display: block;
    margin-bottom: var(--space-8);

    animation-name: heroReveal;
    animation-duration: 0.4s;
    animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    animation-fill-mode: both;
    animation-delay: 0.3s;
  }

  /* ─── Headline ────────────────────────────────────────────── */

  .hero-headline {
    display: block;
    margin: 0;
    margin-bottom: var(--space-10);
    /* Prevent browser from adding default h1 margins */
    padding: 0;
  }

  .hero-line {
    display: block;
    font-family: var(--font-display);
    /*
     * Fluid scale: 3.5rem at mobile → 8rem at wide desktop.
     * Tight tracking (-0.04em) per doc 11 Part 6.
     * Line-height 1.0 for maximum density at display scale.
     */
    font-size: clamp(3.25rem, 1.5rem + 7vw, 8rem);
    font-weight: 700;
    line-height: 1.0;
    letter-spacing: -0.04em;
    color: var(--color-ink);

    animation-name: heroReveal;
    animation-duration: 0.55s;
    animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    animation-fill-mode: both;
  }

  .hero-line-1 {
    animation-delay: 1.0s;
  }

  /* "No sitios." — shorter line, arrives after a reading pause */
  .hero-line-2 {
    animation-delay: 2.3s;
    /*
     * The second line is intentionally shorter.
     * At desktop, "No sitios." will occupy roughly 40% of the
     * width of "Construimos sistemas." — the asymmetry is compositional.
     */
  }

  /* ─── Subheadline ─────────────────────────────────────────── */

  .hero-sub {
    font-family: var(--font-body);
    font-size: clamp(1rem, 0.85rem + 0.6vw, 1.2rem);
    font-weight: var(--weight-regular);
    line-height: 1.65;
    color: var(--color-grey-mid);
    max-width: 560px;
    margin: 0;
    margin-bottom: var(--space-10);

    animation-name: heroReveal;
    animation-duration: 0.55s;
    animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    animation-fill-mode: both;
    animation-delay: 3.6s;
  }

  /* ─── Actions ─────────────────────────────────────────────── */

  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: wrap;
    margin-bottom: var(--space-6);

    animation-name: heroReveal;
    animation-duration: 0.5s;
    animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    animation-fill-mode: both;
    animation-delay: 4.7s;
  }

  /* Primary — lime pill, slightly larger than the global .btn default */
  .hero-btn-primary {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: 0.01em;
    color: var(--color-ink);
    background-color: var(--color-lime);
    border-radius: var(--radius-full);
    padding: 14px 28px;
    line-height: 1;
    white-space: nowrap;
    transition:
      background-color 150ms ease,
      transform        100ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .hero-btn-primary:hover {
      background-color: #CEFF00;
    }
  }

  .hero-btn-primary:active {
    transform: scale(0.97);
  }

  /* Secondary — text link with animated arrow gap */
  .hero-btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-regular);
    color: var(--color-grey-soft);
    padding: 14px 0;
    line-height: 1;
    transition:
      color 150ms ease,
      gap   300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    .hero-btn-secondary:hover {
      color: var(--color-ink);
      gap: var(--space-4);
    }

    .hero-btn-secondary:hover .hero-arrow {
      transform: translateX(3px);
    }
  }

  .hero-arrow {
    flex-shrink: 0;
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* ─── Microcopy ───────────────────────────────────────────── */

  .hero-microcopy {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: var(--weight-regular);
    line-height: 1.5;
    color: var(--color-grey-soft);
    letter-spacing: 0.01em;

    animation-name: heroReveal;
    animation-duration: 0.4s;
    animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    animation-fill-mode: both;
    animation-delay: 5.4s;
  }

  /* ─── Tablet ──────────────────────────────────────────────── */

  @media (max-width: 900px) {
    .hero-mark {
      right: clamp(20px, 4vw, 48px);
    }
  }

  /* ─── Mobile ──────────────────────────────────────────────── */
  /*
   * Mobile is not a reduced version — it's a first-class experience.
   * Typography remains large and impactful. The mark steps back rather
   * than centering — on a narrow viewport it has no negative space left
   * to occupy without crowding the text, so it recedes instead of
   * relocating awkwardly.
   */
  @media (max-width: 600px) {
    .hero {
      padding-block: clamp(100px, 20vw, 140px) clamp(60px, 10vw, 100px);
    }

    .hero-mark {
      right: 16px;
      top: 20%;
      bottom: 30%;
      opacity: 0.6;
    }

    .hero-sub {
      max-width: 100%;
    }

    .hero-actions {
      gap: var(--space-4);
    }

    .hero-btn-primary {
      padding: 13px 24px;
    }
  }

  /* ─── Reduced motion ──────────────────────────────────────── */
  /*
   * When prefers-reduced-motion is set:
   *   1. Remove all animations entirely (not just shorten them)
   *   2. Explicitly set opacity:1 so elements are immediately visible
   *
   * Note: the global motion.css sets animation-duration: 0.01ms !important
   * but does NOT handle the case where animation-delay is still 6.5s,
   * which would leave elements invisible for that duration.
   * This explicit override prevents that.
   */
  @media (prefers-reduced-motion: reduce) {
    .hero-label,
    .hero-line,
    .hero-sub,
    .hero-actions,
    .hero-microcopy {
      animation: none;
      opacity: 1;
      transform: none;
    }

    .hero-mark-tick {
      animation: none;
      opacity: 1;
      transform: rotate(-24deg);
    }

    .hero-mark-line {
      animation: none;
      transform: scaleY(1);
    }
  }
</style>
