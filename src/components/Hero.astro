---
/**
 * Hero.astro — Concept 4: "La Primera Decisión" + Phase 5.1 visual component
 * doc 11 is highest authority for copy/hierarchy — unchanged.
 *
 * Iteration note: the Phase 5 hairline-and-ticks device (a near-invisible
 * 1px line standing in for the isotipo) was reviewed on the live site and
 * didn't land — it read as an accidental stray element, not a considered
 * one, which is the same failure mode as the watermark it replaced, just
 * quieter. Retired.
 *
 * What replaces it: the isotipo itself, solid ink, fully opaque, at real
 * scale — a compositional object beside the headline, not a background.
 * It arrives as the last event of the sequence: the two shapes travel
 * into their final position along their locked trajectory (doc 11 Part 4
 * — upper shape moves up-and-right, lower shape moves down-and-right,
 * neither rotates) and settle with a spring overshoot, the same
 * "arrival" quality as Método's step-04 assembly, but here it's the
 * Hero's own signature, not a borrowed technique.
 *
 * Copy source: doc 12, Part 9 (Final Hero Copy Lock) — unchanged.
 *
 * Motion — compressed per docs/18 Part 4.2 (microcopy lands at 5.4s):
 *   Label    → delay 0.3s,  duration 0.4s
 *   Line 1   → delay 1.0s,  duration 0.55s
 *   Line 2   → delay 2.3s,  duration 0.55s
 *   Sub      → delay 3.6s,  duration 0.55s
 *   Actions  → delay 4.7s,  duration 0.50s
 *   Microcopy→ delay 5.4s,  duration 0.40s
 *   Mark     → delay 5.6s,  duration 0.9s  (the last event)
 */

import Isotipo from './Isotipo.astro';
---

<section class="hero" aria-label="Inicio" id="inicio" data-theme="light">

  <!--
    The isotipo — solid, opaque, a real object in the composition.
    Arrives last, once the reading is done, and stays exactly where it
    lands. No opacity trick, no background role.
  -->
  <div class="hero-mark" aria-hidden="true">
    <Isotipo tone="ink" class="hero-mark-svg" />
  </div>

  <!-- Content — sequential reveal -->
  <div class="hero-content">

    <!--
      Section label — Rule 6 (doc 11): every section begins with a
      label above the headline, never directly with the headline.
    -->
    <p class="hero-label text-label">
      Infraestructura Digital
    </p>

    <!--
      Primary headline — two discrete lines.
      Each span is display:block so they stack as separate lines
      and can animate independently at their own delay.
      No <br> — the spans control the line break structurally.
    -->
    <h1 class="hero-headline">
      <span class="hero-line hero-line-1">Construimos sistemas.</span>
      <span class="hero-line hero-line-2">No sitios.</span>
    </h1>

    <!-- Subheadline — one thought, no line breaks forced on desktop -->
    <p class="hero-sub">
      De la primera visita al cliente que paga: sin
      seguimiento manual, sin leads perdidos, sin plantillas.
    </p>

    <!-- CTA group — primary lime + secondary ghost -->
    <div class="hero-actions" role="group" aria-label="Acciones principales">
      <a href="#servicios" class="btn btn-primary hero-btn-primary" data-cursor-tone="action">
        Ver cómo funciona
      </a>
      <a href="#proyectos" class="hero-btn-secondary">
        Ver proyectos
        <svg class="hero-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

    <!-- Microcopy — audience qualifier -->
    <p class="hero-microcopy">
      Para clínicas, despachos y negocios que han superado las plantillas.
    </p>

  </div>

</section>

<style>
  /* ─── Keyframe ────────────────────────────────────────────── */
  /*
   * Single keyframe used by all hero content elements.
   * Named heroReveal to avoid collision with global fadeUp.
   * 28px entrance offset (slightly smaller than the global 32px
   * to match the delicate pacing of this concept).
   */
  @keyframes heroReveal {
    from {
      opacity: 0;
      transform: translateY(28px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ─── Section ─────────────────────────────────────────────── */

  .hero {
    position: relative;
    min-height: 100svh;
    background-color: var(--color-cream);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-block: clamp(80px, 10vw, 140px);
    padding-inline: clamp(24px, 5vw, 80px);
    overflow: hidden;
  }

  /* ─── The mark ────────────────────────────────────────────── */
  /*
   * Phase 5.1. The isotipo, solid ink, real scale, positioned as a real
   * object in the negative space beside the headline — not a background,
   * not translucent. :global() is required on the shape selectors below:
   * they target <path> elements rendered inside the <Isotipo> child
   * component, which Astro's CSS scoping does not reach (see the same
   * note in CTA.astro / Method.astro / SystemEntry.astro).
   */
  .hero-mark {
    position: absolute;
    right: clamp(32px, 7vw, 130px);
    top: 50%;
    transform: translateY(-50%);
    width: clamp(130px, 13vw, 210px);
    pointer-events: none;
    user-select: none;
  }

  :global(.hero-mark-svg) {
    width: 100%;
    height: auto;
    max-width: none;
  }

  /* Each shape travels along its own locked trajectory (doc 11 Part 4)
     into the position the SVG paths already define relative to each
     other — this is an approach, not a repositioning. */
  :global(.hero-mark-svg .isotipo-shape-a) {
    opacity: 0;
    transform: translate(-34px, 26px);
    animation: heroMarkArriveA 900ms var(--ease-spring) both;
    animation-delay: 5.6s;
  }

  :global(.hero-mark-svg .isotipo-shape-b) {
    opacity: 0;
    transform: translate(-26px, -34px);
    animation: heroMarkArriveB 900ms var(--ease-spring) both;
    animation-delay: 5.75s;
  }

  @keyframes heroMarkArriveA {
    from { opacity: 0; transform: translate(-34px, 26px); }
    to   { opacity: 1; transform: translate(0, 0); }
  }

  @keyframes heroMarkArriveB {
    from { opacity: 0; transform: translate(-26px, -34px); }
    to   { opacity: 1; transform: translate(0, 0); }
  }

  /* ─── Content ─────────────────────────────────────────────── */

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 900px;
  }

  /* ─── Label ───────────────────────────────────────────────── */

  .hero-label {
    display: block;
    margin-bottom: var(--space-8);

    animation-name: heroReveal;
    animation-duration: 0.4s;
    animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    animation-fill-mode: both;
    animation-delay: 0.3s;
  }

  /* ─── Headline ────────────────────────────────────────────── */

  .hero-headline {
    display: block;
    margin: 0;
    margin-bottom: var(--space-10);
    /* Prevent browser from adding default h1 margins */
    padding: 0;
  }

  .hero-line {
    display: block;
    font-family: var(--font-display);
    /*
     * Fluid scale: 3.5rem at mobile → 8rem at wide desktop.
     * Tight tracking (-0.04em) per doc 11 Part 6.
     * Line-height 1.0 for maximum density at display scale.
     */
    font-size: clamp(3.25rem, 1.5rem + 7vw, 8rem);
    font-weight: 700;
    line-height: 1.0;
    letter-spacing: -0.04em;
    color: var(--color-ink);

    animation-name: heroReveal;
    animation-duration: 0.55s;
    animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    animation-fill-mode: both;
  }

  .hero-line-1 {
    animation-delay: 1.0s;
  }

  /* "No sitios." — shorter line, arrives after a reading pause */
  .hero-line-2 {
    animation-delay: 2.3s;
    /*
     * The second line is intentionally shorter.
     * At desktop, "No sitios." will occupy roughly 40% of the
     * width of "Construimos sistemas." — the asymmetry is compositional.
     */
  }

  /* ─── Subheadline ─────────────────────────────────────────── */

  .hero-sub {
    font-family: var(--font-body);
    font-size: clamp(1rem, 0.85rem + 0.6vw, 1.2rem);
    font-weight: var(--weight-regular);
    line-height: 1.65;
    color: var(--color-grey-mid);
    max-width: 560px;
    margin: 0;
    margin-bottom: var(--space-10);

    animation-name: heroReveal;
    animation-duration: 0.55s;
    animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    animation-fill-mode: both;
    animation-delay: 3.6s;
  }

  /* ─── Actions ─────────────────────────────────────────────── */

  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: wrap;
    margin-bottom: var(--space-6);

    animation-name: heroReveal;
    animation-duration: 0.5s;
    animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    animation-fill-mode: both;
    animation-delay: 4.7s;
  }

  /* Primary — lime pill, slightly larger than the global .btn default */
  .hero-btn-primary {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: 0.01em;
    color: var(--color-ink);
    background-color: var(--color-lime);
    border-radius: var(--radius-full);
    padding: 14px 28px;
    line-height: 1;
    white-space: nowrap;
    transition:
      background-color 150ms ease,
      transform        100ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .hero-btn-primary:hover {
      background-color: #CEFF00;
    }
  }

  .hero-btn-primary:active {
    transform: scale(0.97);
  }

  /* Secondary — text link with animated arrow gap */
  .hero-btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-regular);
    color: var(--color-grey-soft);
    padding: 14px 0;
    line-height: 1;
    transition:
      color 150ms ease,
      gap   300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    .hero-btn-secondary:hover {
      color: var(--color-ink);
      gap: var(--space-4);
    }

    .hero-btn-secondary:hover .hero-arrow {
      transform: translateX(3px);
    }
  }

  .hero-arrow {
    flex-shrink: 0;
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* ─── Microcopy ───────────────────────────────────────────── */

  .hero-microcopy {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    line-height: 1.5;
    color: var(--color-grey-mid);
    letter-spacing: 0.01em;
    margin-top: var(--space-2);

    animation-name: heroReveal;
    animation-duration: 0.4s;
    animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    animation-fill-mode: both;
    animation-delay: 5.4s;
  }

  /* ─── Tablet ──────────────────────────────────────────────── */

  @media (max-width: 900px) {
    .hero-mark {
      right: clamp(20px, 4vw, 48px);
    }
  }

  /* ─── Mobile ──────────────────────────────────────────────── */
  /*
   * Mobile is not a reduced version — it's a first-class experience.
   * Typography remains large and impactful. The mark steps back rather
   * than centering — on a narrow viewport it has no negative space left
   * to occupy without crowding the text, so it recedes instead of
   * relocating awkwardly.
   */
  @media (max-width: 600px) {
    .hero {
      padding-block: clamp(100px, 20vw, 140px) clamp(60px, 10vw, 100px);
    }

    .hero-mark {
      right: 16px;
      width: 84px;
    }

    .hero-sub {
      max-width: 100%;
    }

    .hero-actions {
      gap: var(--space-4);
    }

    .hero-btn-primary {
      padding: 13px 24px;
    }
  }

  /* ─── Reduced motion ──────────────────────────────────────── */
  /*
   * When prefers-reduced-motion is set:
   *   1. Remove all animations entirely (not just shorten them)
   *   2. Explicitly set opacity:1 so elements are immediately visible
   *
   * Note: the global motion.css sets animation-duration: 0.01ms !important
   * but does NOT handle the case where animation-delay is still 6.5s,
   * which would leave elements invisible for that duration.
   * This explicit override prevents that.
   */
  @media (prefers-reduced-motion: reduce) {
    .hero-label,
    .hero-line,
    .hero-sub,
    .hero-actions,
    .hero-microcopy {
      animation: none;
      opacity: 1;
      transform: none;
    }

    :global(.hero-mark-svg .isotipo-shape-a),
    :global(.hero-mark-svg .isotipo-shape-b) {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
