---
/**
 * Method.astro — Phase 5
 *
 * Structure, copy and rhythm unchanged (approved: "la estructura es muy
 * buena, no quiero cambiar el contenido"). What's elevated:
 *   - Step numerals scale up substantially — they earn the "sienten
 *     especiales" the brief asked for through scale, not ornament.
 *   - A single spine connects all four numerals — the steps stop reading
 *     as four separate items and start reading as one continuous line.
 *   - Step 04 ("Verificamos") is where the isotipo's two shapes assemble
 *     into the complete mark — doc 11's own reading of the isotipo
 *     ("dos sistemas en equilibrio dinámico") made literal at the exact
 *     step that verifies the system works. A quiet detail, not the site's
 *     signature moment (that's the cursor, docs/19) — this one rewards
 *     someone who's actually reading, nothing more.
 *   - Real scroll-triggered stagger reveal (150ms/step, per doc 04's
 *     already-written standard) — previously entirely static.
 */

import Isotipo from './Isotipo.astro';

const steps = [
  {
    num: '01',
    name: 'Entendemos',
    body: 'Antes de diseñar, preguntamos. ¿Dónde se pierden los clientes? ¿Qué tarea se repite más? ¿Qué herramientas ya tienes y cuáles no están conectadas?',
  },
  {
    num: '02',
    name: 'Diseñamos',
    body: 'Diseñamos el sistema completo antes de escribir código. El sitio, las automatizaciones, las integraciones: todo conectado desde el principio.',
  },
  {
    num: '03',
    name: 'Construimos',
    body: 'Construimos el sitio y todo lo que lo conecta a tu operación. No entregamos piezas sueltas, entregamos el sistema completo.',
  },
  {
    num: '04',
    name: 'Verificamos',
    body: 'El sistema funciona antes de que lo llamemos terminado. Probamos cada flujo, cada integración, cada punto de contacto con el cliente.',
  },
];
---

<section class="method section section-dark" id="metodo" aria-label="Método" data-theme="dark">

  <div class="container method-container">

    <!-- Section header — label above headline per Rule 6 -->
    <header class="method-header" data-reveal>
      <p class="text-label method-lbl">Método</p>
      <h2 class="method-headline">Cómo funciona.</h2>
      <p class="method-intro">
        No empezamos con diseños. Empezamos por entender cómo opera tu negocio.
      </p>
    </header>

    <!-- Steps — ordered list: sequence matters, order carries information -->
    <ol class="method-steps" role="list">
      {steps.map((step, i) => (
        <li
          class:list={['method-step', step.num === '04' && 'method-step--final']}
          data-reveal
          data-reveal-delay={i * 150}
        >
          <span class="step-num text-mono" aria-hidden="true">{step.num}</span>
          <div class="step-content">
            <h3 class="step-name">{step.name}</h3>
            <p class="step-body">{step.body}</p>
          </div>
          {step.num === '04' && (
            <div class="step-assembly" aria-hidden="true">
              <Isotipo single="a" tone="cream" class="assembly-shape assembly-shape-a" />
              <Isotipo single="b" tone="cream" class="assembly-shape assembly-shape-b" />
            </div>
          )}
        </li>
      ))}
    </ol>

  </div>

</section>

<style>
  /* ── Section ────────────────────────────────────────────────── */

  .method {
    overflow: hidden;
  }

  /* ── Container ──────────────────────────────────────────────── */
  /*
   * Explicit z-index:1 ensures content sits above noise grain
   * and the isotipo background mark.
   */

  .method-container {
    position: relative;
    z-index: 1;
  }

  /* ── Header ─────────────────────────────────────────────────── */

  .method-header {
    max-width: 580px;
    margin-bottom: var(--space-16);
  }

  .method-lbl {
    display: block;
    margin-bottom: var(--space-5);
    color: var(--color-grey-dim-dark);
  }

  /* Item 7 (doc 11): 20–24px gap between label and headline */

  .method-headline {
    margin: 0 0 var(--space-8);
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.2rem + 4.5vw, 5.5rem);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--color-cream);
  }

  .method-intro {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-grey-mid-dark);
    margin: 0;
    max-width: 480px;
  }

  /* ── Steps ──────────────────────────────────────────────────── */
  /*
   * The spine (::before) connects all four numerals into one line — the
   * steps stop reading as four separate items. left offset is tuned to
   * sit just past the numeral glyphs, matching .step-num::after's dot.
   */

  .method-steps {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .method-steps::before {
    content: '';
    position: absolute;
    top: var(--space-12);
    bottom: var(--space-12);
    left: 88px;
    width: 1px;
    background-color: var(--color-border-dark);
  }

  /* ── Step row ───────────────────────────────────────────────── */
  /*
   * Grid: [step number fixed] [step content fills remaining width]
   * The numeral is elevated to display scale — it earns its place
   * through size, not ornament (brief: "los números deben sentirse
   * especiales").
   */

  .method-step {
    position: relative;
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: var(--space-8);
    padding-block: var(--space-10);
    border-top: 1px solid var(--color-border-dark);
    align-items: start;
  }

  .step-num {
    position: relative;
    font-family: var(--font-mono);
    font-size: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    font-weight: var(--weight-medium);
    color: var(--color-grey-dim-dark);
    line-height: 1;
  }

  /* Dot on the spine — lime only on the final step (doc 17 Part 6: lime
     marks the step where the system is confirmed to work). */
  .step-num::after {
    content: '';
    position: absolute;
    left: 84px;
    top: 50%;
    width: 6px;
    height: 6px;
    margin-top: -3px;
    border-radius: 50%;
    background-color: var(--color-grey-dim-dark);
  }

  .method-step--final .step-num::after {
    background-color: var(--color-lime);
  }

  .step-name {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-snug);
    color: var(--color-cream);
    margin: 0 0 var(--space-4);
  }

  .step-body {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-grey-mid-dark);
    margin: 0;
    max-width: 52ch;
  }

  /* ── Isotipo assembly — step 04 only ──────────────────────────
   * The two shapes start apart and settle into the complete mark once
   * the step is revealed (same [data-reveal].is-visible toggle that
   * drives the rest of the stagger — no separate trigger needed).
   */

  .step-assembly {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 64px;
    opacity: 0.7;
    pointer-events: none;
  }

  /* :global() — these classes size/animate <svg> elements rendered inside
     the <Isotipo> child component, which Astro's scoping never reaches. */
  :global(.assembly-shape) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: auto;
    transition:
      transform 700ms var(--ease-out-expo),
      opacity   700ms var(--ease-out-expo);
    opacity: 0;
  }

  :global(.assembly-shape-a) {
    transform: translate(-16px, -12px);
  }

  :global(.assembly-shape-b) {
    transform: translate(16px, 12px);
  }

  :global([data-reveal].is-visible .assembly-shape) {
    opacity: 1;
    transform: translate(0, 0);
  }

  /* ── Mobile — 768px and below ───────────────────────────────── */

  @media (max-width: 768px) {
    .method-step {
      grid-template-columns: 48px 1fr;
      gap: var(--space-5);
      padding-block: var(--space-8);
    }

    .method-steps::before {
      left: 58px;
    }

    .step-num::after {
      left: 54px;
    }

    .step-num {
      font-size: 1.5rem;
    }

    .step-assembly {
      display: none;
    }

    .method-intro {
      max-width: 100%;
    }
  }
</style>
