---
/**
 * Nav.astro — Phase 2A (desktop) + Phase 6 (mobile-native menu)
 *
 * Desktop design decisions unchanged:
 *   - Dark pill on cream hero creates maximum contrast (doc 11: "dark, floating")
 *   - Centered via left:50% + transform:translateX(-50%) on the wrapper
 *   - Entrance: 400ms delay on first visit, immediate on subsequent navigations
 *   - Hover: mechanical — background fill, no movement, no spring
 *   - Active state: lime dot + cream text
 *
 * Phase 6 mobile audit, finding 1: below 768px, .nav-links was simply
 * display:none with nothing replacing it — Servicios/Método/Proyectos/
 * Contacto were unreachable except by scrolling. This adds a real menu:
 * a toggle button (≤768px only) that opens a full-screen overlay with the
 * same four links at a scale built for a thumb, not a cursor — see the
 * overlay's own styles below for the mobile-specific rhythm (this is not
 * the desktop pill's `.nav-links` reused at a bigger size).
 *
 * Also mobile-only (Phase 6, findings 6 and 8): the wrapper's top offset
 * respects env(safe-area-inset-top), and the pill hides on scroll-down /
 * reveals on scroll-up below 768px — desktop's pill stays exactly as it
 * was, always visible.
 */

const navLinks = [
  { href: '#servicios', label: 'Servicios' },
  { href: '#metodo',    label: 'Método'    },
  { href: '#proyectos', label: 'Proyectos' },
  { href: '#contacto',  label: 'Contacto'  },
];
---

<header class="nav-wrapper" role="banner">
  <nav class="nav-pill" data-nav aria-label="Navegación principal">

    <!-- Wordmark — always lowercase, Rule 7 (doc 11) -->
    <a href="/" class="nav-wordmark" aria-label="Verk — Inicio">
      verk
    </a>

    <!-- Visual separator -->
    <span class="nav-divider" aria-hidden="true"></span>

    <!-- Navigation links — desktop only from 769px up; hidden below that
         in favor of the menu toggle + overlay (mobile-native, not reused). -->
    <ul class="nav-links" role="list">
      {navLinks.map(({ href, label }) => (
        <li>
          <a href={href} class="nav-link">
            {label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Mobile menu toggle — the icon morphs between two states via CSS,
         no separate open/close asset. aria-expanded is wired by nav.ts. -->
    <button
      type="button"
      class="nav-menu-toggle"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="mobile-nav-menu"
      aria-label="Abrir menú de navegación"
    >
      <span class="nav-menu-icon" aria-hidden="true">
        <span></span>
        <span></span>
      </span>
    </button>

    <!-- Primary CTA — desktop only; the overlay carries its own CTA on mobile -->
    <a href="#contacto" class="nav-cta" data-cursor-tone="action">
      Auditoría
    </a>

  </nav>
</header>

<!--
  Mobile menu overlay — deliberately a SIBLING of <header>, not nested
  inside it. .nav-wrapper carries `transform: translateX(-50%)` for its
  own centering, and a `transform` on an ancestor creates a new
  containing block for any `position: fixed` descendant — the overlay
  was resolving `inset:0` against the pill's own small box (~100×50px)
  instead of the viewport. Real bug, caught in Playwright visual QA
  (computed rect was 102×52px, not the viewport). Moving the overlay
  outside the transformed ancestor fixes it; everything else (styles,
  script wiring) is unchanged.
-->
<div class="nav-menu-overlay" id="mobile-nav-menu" data-nav-overlay inert>
  <ul class="nav-menu-list" role="list">
    {navLinks.map(({ href, label }, i) => (
      <li style={`--i:${i}`}>
        <a href={href} class="nav-menu-link" data-nav-overlay-link>
          {label}
        </a>
      </li>
    ))}
  </ul>
  <a href="#contacto" class="btn btn-primary nav-menu-cta" data-nav-overlay-link data-cursor-tone="action">
    Solicitar auditoría
  </a>
</div>

<!-- Nav entrance — first visit animates, subsequent navigations skip -->
<script>
  function initNav(): void {
    const nav = document.querySelector<HTMLElement>('[data-nav]');
    if (!nav) return;

    const isFirstLoad = !sessionStorage.getItem('verk-nav-seen');
    sessionStorage.setItem('verk-nav-seen', '1');

    if (isFirstLoad) {
      setTimeout(() => nav.classList.add('is-visible'), 400);
    } else {
      nav.classList.add('is-visible');
    }
  }

  document.addEventListener('astro:page-load', initNav);
</script>

<!-- Mobile menu open/close + scroll-aware hide (Phase 6) -->
<script>
  function initMobileMenu(): void {
    const wrapper = document.querySelector<HTMLElement>('.nav-wrapper');
    const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const overlay = document.querySelector<HTMLElement>('[data-nav-overlay]');
    if (!wrapper || !toggle || !overlay) return;

    const links = overlay.querySelectorAll<HTMLElement>('[data-nav-overlay-link]');

    function closeMenu(): void {
      toggle!.setAttribute('aria-expanded', 'false');
      toggle!.setAttribute('aria-label', 'Abrir menú de navegación');
      overlay!.classList.remove('is-open');
      overlay!.setAttribute('inert', '');
      document.body.classList.remove('nav-menu-locked');
    }

    function openMenu(): void {
      toggle!.setAttribute('aria-expanded', 'true');
      toggle!.setAttribute('aria-label', 'Cerrar menú de navegación');
      overlay!.classList.add('is-open');
      overlay!.removeAttribute('inert');
      document.body.classList.add('nav-menu-locked');
    }

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      if (isOpen) closeMenu();
      else openMenu();
    });

    links.forEach((link) => link.addEventListener('click', closeMenu));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') closeMenu();
    });

    // Scroll-aware hide/reveal — mobile only. Desktop's pill always stays put.
    const mobileQuery = window.matchMedia('(max-width: 768px)');
    let lastY = window.scrollY;
    let ticking = false;

    function onScroll(): void {
      if (!mobileQuery.matches || overlay!.classList.contains('is-open')) {
        ticking = false;
        return;
      }
      const y = window.scrollY;
      const delta = y - lastY;
      if (y > 120 && delta > 4) {
        wrapper!.classList.add('is-hidden');
      } else if (delta < -4 || y < 120) {
        wrapper!.classList.remove('is-hidden');
      }
      lastY = y;
      ticking = false;
    }

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          requestAnimationFrame(onScroll);
          ticking = true;
        }
      },
      { passive: true }
    );
  }

  document.addEventListener('astro:page-load', initMobileMenu);
</script>

<style>
  /* ── Positioning wrapper ──────────────────────────────────── */
  /*
   * Wrapper is centered via left:50% + translateX(-50%).
   * pointer-events:none so the empty space around the pill
   * doesn't block hero interactions.
   */
  .nav-wrapper {
    position: fixed;
    /* max() with the safe-area inset — on a notched/Dynamic-Island phone
       the pill clears it; on everything else this is just --space-6. */
    top: max(var(--space-6), env(safe-area-inset-top));
    left: 50%;
    transform: translateX(-50%);
    /*
     * Above --z-overlay (the mobile menu, Phase 6), not just
     * --z-floating — the pill's toggle button morphs into the close (X)
     * icon while the menu is open and must stay tappable on top of the
     * overlay it controls. Caught in Playwright QA: the second tap to
     * close was silently swallowed by the overlay sitting above it.
     */
    z-index: var(--z-modal);
    pointer-events: none;
    /* Prevent the pill from wrapping on small screens */
    white-space: nowrap;
    transition: transform var(--duration-normal) var(--ease-out-expo), opacity var(--duration-normal) var(--ease-out-expo);
  }

  /* Scroll-aware hide — mobile only (toggled by nav.ts, gated to ≤768px
     there). Slides up and fades rather than a hard cut. */
  .nav-wrapper.is-hidden {
    transform: translateX(-50%) translateY(-140%);
    opacity: 0;
  }

  /* ── Pill ─────────────────────────────────────────────────── */

  .nav-pill {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 0;
    padding: 6px 6px 6px 20px;
    background-color: rgba(17, 17, 17, 0.90);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(240, 238, 233, 0.08);
    border-radius: var(--radius-full);

    /* Entrance — starts hidden, becomes visible via .is-visible */
    opacity: 0;
    transform: translateY(-10px) scale(1);
    /*
     * Theme-shift properties use --ease-spring, not --ease-out-expo.
     * A material genuinely changing (not just a color lerp) has a beat
     * of resistance before it settles — spring is what makes a state
     * change read as physical instead of "a CSS transition happened."
     */
    transition:
      opacity           600ms var(--ease-out-expo),
      transform         600ms var(--ease-out-expo),
      background-color  650ms var(--ease-spring),
      border-color       650ms var(--ease-spring),
      backdrop-filter    650ms var(--ease-spring);
  }

  .nav-pill.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Live header — reacts to the chapter behind it ───────────
   * Driven by [data-scroll-theme] on <html>, written by
   * src/scripts/nav-theme.ts. Paused during the Hero's own entrance so
   * the nav never reacts mid-appearance. One shared duration/easing
   * across background/border/blur — a desynced timing is what makes a
   * theme switch feel like a hack instead of something organic.
   *
   * Four keys, reused deliberately rather than one-per-section — chapters
   * that share a surface tone AND an accent share a nav state, which is
   * itself a small echo between chapters that belong to the same family:
   *   light      — Hero, Footer (cream, no accent) — the base pill above.
   *   lime-light — Método (cream, lime accent) — same pill, lime-tinted edge.
   *   violet     — Servicios, Sistemas (near-black, violet accent) — pill inverts.
   *   feature    — CTA (ink-deep, lime accent, the decision moment) — deepest glass.
   */

  /* Método — cream bg, same dark pill as the base state, lime-dust edge. */
  :global(html[data-scroll-theme='lime-light']) .nav-pill {
    border-color: rgba(191, 234, 0, 0.14);
  }

  /* Servicios + Sistemas — near-black bg, pill inverts to cream, violet edge. */
  :global(html[data-scroll-theme='violet']) .nav-pill {
    background-color: rgba(240, 238, 233, 0.88);
    border-color: rgba(107, 106, 244, 0.22);
  }

  :global(html[data-scroll-theme='violet']) .nav-wordmark {
    color: var(--color-ink);
  }

  :global(html[data-scroll-theme='violet']) .nav-divider {
    background-color: rgba(15, 15, 15, 0.14);
  }

  :global(html[data-scroll-theme='violet']) .nav-link {
    color: rgba(15, 15, 15, 0.55);
  }

  @media (hover: hover) and (pointer: fine) {
    :global(html[data-scroll-theme='violet']) .nav-link:hover {
      color: var(--color-ink);
      background-color: rgba(15, 15, 15, 0.08);
    }
  }

  /* CTA — the decision moment: deeper glass, lime-tinted edge. */
  :global(html[data-scroll-theme='feature']) .nav-pill {
    background-color: rgba(8, 8, 8, 0.75);
    border-color: rgba(191, 234, 0, 0.22);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  :global(html[data-scroll-theme='feature']) .nav-wordmark {
    color: var(--color-cream);
  }

  :global(html[data-scroll-theme='feature']) .nav-link {
    color: rgba(240, 238, 233, 0.55);
  }

  /* ── Wordmark ─────────────────────────────────────────────── */

  .nav-wordmark {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: var(--weight-bold);
    letter-spacing: -0.02em;
    color: var(--color-cream);
    line-height: 1;
    flex-shrink: 0;
    padding-right: var(--space-4);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-wordmark:hover {
      color: rgba(240, 238, 233, 0.75);
    }
  }

  /* ── Divider ──────────────────────────────────────────────── */

  .nav-divider {
    width: 1px;
    height: 14px;
    background-color: rgba(240, 238, 233, 0.12);
    flex-shrink: 0;
    margin-right: var(--space-2);
  }

  /* ── Links ────────────────────────────────────────────────── */

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0;
  }

  .nav-link {
    display: block;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: var(--weight-regular);
    color: rgba(240, 238, 233, 0.50);
    line-height: 1;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-full);
    transition:
      color            150ms ease,
      background-color 150ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-link:hover {
      color: var(--color-cream);
      background-color: rgba(240, 238, 233, 0.08);
    }
  }

  /*
   * Active state — applied via JS IntersectionObserver in Phase 4.
   * Lime dot before the active link text.
   */
  .nav-link.is-active {
    color: var(--color-cream);
    font-weight: var(--weight-medium);
  }

  .nav-link.is-active::before {
    content: '';
    display: inline-block;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background-color: var(--color-lime);
    margin-right: 6px;
    vertical-align: middle;
    position: relative;
    top: -1px;
  }

  /* ── CTA ──────────────────────────────────────────────────── */
  /*
   * The CTA is not using the global .btn class here — its padding
   * and size are tuned specifically to live inside the pill.
   */
  .nav-cta {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: var(--weight-medium);
    letter-spacing: 0.01em;
    color: var(--color-ink);
    background-color: var(--color-lime);
    border-radius: var(--radius-full);
    padding: 8px 16px;
    margin-left: var(--space-2);
    flex-shrink: 0;
    line-height: 1;
    transition:
      background-color 150ms ease,
      transform        100ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-cta:hover {
      background-color: var(--color-lime-hover);
    }
  }

  .nav-cta:active {
    transform: scale(0.97);
  }

  /* ── Mobile menu toggle ───────────────────────────────────────
   * Hidden by default (desktop) — shown only ≤768px, see media query
   * below. Two-line icon that rotates into an X — one element, two
   * states, no separate open/close asset to swap.
   */

  .nav-menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    margin-left: var(--space-1);
    background: none;
    border: none;
    border-radius: 50%;
    cursor: pointer;
    flex-shrink: 0;
  }

  .nav-menu-icon {
    position: relative;
    width: 16px;
    height: 12px;
  }

  .nav-menu-icon span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    border-radius: 1px;
    background-color: var(--color-cream);
    transition:
      transform 300ms var(--ease-spring),
      opacity   200ms var(--ease-out-expo),
      top       300ms var(--ease-spring),
      background-color 300ms var(--ease-out-expo);
  }

  :global(html[data-scroll-theme='violet']) .nav-menu-icon span,
  :global(html[data-scroll-theme='feature']) .nav-menu-icon span {
    background-color: var(--color-cream);
  }

  :global(html[data-scroll-theme='violet']) .nav-menu-icon span {
    background-color: var(--color-ink);
  }

  .nav-menu-icon span:first-child { top: 0; }
  .nav-menu-icon span:last-child { top: 10px; }

  [aria-expanded='true'] .nav-menu-icon span:first-child {
    top: 5px;
    transform: rotate(45deg);
  }

  [aria-expanded='true'] .nav-menu-icon span:last-child {
    top: 5px;
    transform: rotate(-45deg);
  }

  /* ── Mobile menu overlay ──────────────────────────────────────
   * A distinct surface (ink, full-screen), not the desktop nav-links
   * reused at a bigger size — links get real thumb-sized targets and
   * their own entrance stagger.
   */

  .nav-menu-overlay {
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-12);
    background-color: rgba(15, 15, 15, 0.98);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 350ms var(--ease-out-expo),
      visibility 0s linear 350ms;
    padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);
  }

  .nav-menu-overlay.is-open {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 350ms var(--ease-out-expo),
      visibility 0s linear 0s;
  }

  .nav-menu-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }

  .nav-menu-list li {
    overflow: hidden;
  }

  .nav-menu-link {
    display: block;
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: clamp(2rem, 1.5rem + 4vw, 2.75rem);
    letter-spacing: var(--tracking-tight);
    color: var(--color-cream);
    padding: var(--space-3) var(--space-4);
    text-align: center;
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 400ms var(--ease-out-expo),
      transform 400ms var(--ease-out-expo),
      color 150ms ease;
  }

  .nav-menu-overlay.is-open .nav-menu-link {
    opacity: 1;
    transform: translateY(0);
    /* Stagger via the inline --i custom property set per <li> in the markup */
    transition-delay: calc(var(--i, 0) * 60ms + 80ms);
  }

  .nav-menu-link:active {
    color: var(--color-lime);
  }

  .nav-menu-cta {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 400ms var(--ease-out-expo),
      transform 400ms var(--ease-out-expo);
    transition-delay: 380ms;
    font-size: var(--text-base);
    padding: var(--space-4) var(--space-8);
  }

  .nav-menu-overlay.is-open .nav-menu-cta {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-menu-link,
    .nav-menu-cta {
      transition: opacity 150ms linear !important;
      transform: none !important;
      transition-delay: 0ms !important;
    }
  }

  /* ── Responsive ───────────────────────────────────────────── */

  /* Mobile: hide the desktop link list, show the menu toggle instead —
     the overlay (above) is the real mobile nav, not a hidden fallback. */
  @media (max-width: 768px) {
    .nav-links,
    .nav-divider {
      display: none;
    }

    .nav-cta {
      display: none;
    }

    .nav-menu-toggle {
      display: flex;
    }

    .nav-pill {
      padding: 6px 6px 6px 16px;
      gap: var(--space-3);
    }

    .nav-wordmark {
      padding-right: 0;
    }
  }

  /* Small mobile: tighter pill */
  @media (max-width: 390px) {
    .nav-pill {
      padding: 5px 5px 5px 14px;
    }
  }

  /* ── Reduced motion ───────────────────────────────────────── */

  @media (prefers-reduced-motion: reduce) {
    .nav-pill {
      opacity: 1;
      transform: translateY(0);
      transition: none;
    }
  }
</style>
