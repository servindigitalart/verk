---
/**
 * Footer.astro — Phase 5, "Epílogo"
 *
 * Doc 11 Part 10 has an explicit rule this footer never actually followed:
 * "el footer siempre abre con una oración declarativa. No 'contáctanos'."
 * There was no headline at all until now — a gap against the brand's own
 * lock, not a design decision. Fixed here, plus the one closing gesture:
 * the isotipo as punctuation (docs/18 Part 4, row 5) — the single
 * exception to "headlines never end in punctuation," because this is the
 * one headline that is allowed to end the whole site.
 */

import Isotipo from './Isotipo.astro';

const year = new Date().getFullYear();

const serviceLinks = [
  { href: '#servicios',  label: 'Sitios Web'   },
  { href: '#servicios',  label: 'Automatizaciones' },
  { href: '#servicios',  label: 'Integraciones CRM' },
  { href: '#servicios',  label: 'Herramientas con IA' },
];

const secondaryLinks = [
  { href: '/privacidad', label: 'Privacidad' },
  { href: '/terminos',   label: 'Términos'   },
];
---

<footer class="footer section section-dark" role="contentinfo" data-theme="dark">
  <div class="container">

    <p class="footer-headline" data-reveal>
      Seguimos construyendo<Isotipo tone="cream" class="footer-period" />
    </p>

    <div class="footer-inner">

      <!-- Brand block -->
      <div class="footer-brand">
        <a href="/" class="footer-wordmark" aria-label="Verk — Inicio">
          verk
        </a>
        <p class="footer-tagline text-label">
          Conectamos. Automatizamos. Construimos.
        </p>
      </div>

      <!-- Service links -->
      <nav class="footer-nav" aria-label="Servicios">
        <p class="footer-nav-label text-label">Servicios</p>
        <ul role="list" class="footer-links">
          {serviceLinks.map(({ href, label }) => (
            <li>
              <a href={href} class="footer-link link-line">
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- WhatsApp CTA block -->
      <div class="footer-cta-block">
        <p class="footer-cta-text text-body-sm">
          ¿Tienes un proyecto en mente?
        </p>
        <a
          href="https://wa.me/52XXXXXXXXXX?text=Hola%2C%20me%20interesa%20hablar%20sobre%20un%20proyecto"
          class="btn btn-primary"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Contactar por WhatsApp"
          data-cursor-tone="action"
        >
          Escribir por WhatsApp
        </a>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="footer-bottom">
      <p class="footer-copy text-caption">
        &copy; {year} Verk. Hecho con intención.
      </p>
      <ul class="footer-legal" role="list">
        {secondaryLinks.map(({ href, label }) => (
          <li>
            <a href={href} class="footer-link-sm link-line">
              {label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border-dark);
  }

  /* ── Epilogue headline — the declarative sentence doc 11 always
     required and never got, plus the isotipo as the site's one period ──
   * Iteration note: "más presencia, sin agrandarlo" — the lever here is
   * purely typographic weight/contrast, not scale: --weight-black instead
   * of bold, tighter tracking, and the isotipo period sized up slightly
   * relative to the text so it reads as a real mark, not an afterthought.
   */

  .footer-headline {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    font-family: var(--font-display);
    font-weight: var(--weight-black);
    font-size: clamp(1.75rem, 1.2rem + 2.5vw, 3rem);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    color: var(--color-cream);
    margin: 0 0 var(--space-16);
  }

  /* :global() — sizes the <svg> rendered inside the <Isotipo> child;
     Astro's scoping doesn't reach across that component boundary. */
  :global(.footer-period) {
    width: 0.52em;
    height: auto;
    flex-shrink: 0;
    transform: translateY(0.1em);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: var(--space-16);
    padding-bottom: var(--space-16);
    border-bottom: 1px solid var(--color-border-dark);
  }

  .footer-wordmark {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.1rem + 2.5vw, 3.5rem);
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-tight);
    color: var(--color-cream);
    line-height: 1;
    display: block;
    margin-bottom: var(--space-4);
  }

  .footer-tagline {
    color: var(--color-grey-mid-dark);
    font-weight: var(--weight-medium);
  }

  .footer-nav-label {
    color: var(--color-grey-dim-dark);
    margin-bottom: var(--space-6);
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-link {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-grey-mid-dark);
    transition: color var(--duration-fast) var(--ease-out-expo);
  }

  .footer-link:hover {
    color: var(--color-cream);
  }

  .footer-cta-text {
    color: var(--color-grey-mid-dark);
    margin-bottom: var(--space-6);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-8);
  }

  .footer-copy {
    color: var(--color-grey-dim-dark);
  }

  .footer-legal {
    display: flex;
    gap: var(--space-6);
  }

  .footer-link-sm {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-grey-dim-dark);
    transition: color var(--duration-fast) var(--ease-out-expo);
  }

  .footer-link-sm:hover {
    color: var(--color-grey-mid-dark);
  }

  @media (max-width: 1024px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: var(--space-12);
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-4);
    }
  }
</style>
