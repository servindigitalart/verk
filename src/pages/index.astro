---
/**
 * index.astro — Home del rediseño (integración de F3, 2026-11-05). Fuente visual: lab/f3-generative-experience/.
 * Secuencia: Hero (cream, Fluid Halftone) → Servicios (violet) → Método (cream-warm) → Sistemas (ink) → Contacto (lime) → footer (ink).
 * Los componentes anteriores (src/components/*.astro) no se borran; dejan de usarse en la home.
 */
import Experience from '../layouts/Experience.astro';
import Header from '../components/site/Header.astro';
import Hero from '../components/site/Hero.astro';
import Services from '../components/site/Services.astro';
import Method from '../components/site/Method.astro';
import Systems from '../components/site/Systems.astro';
import Contact from '../components/site/Contact.astro';
import Footer from '../components/site/Footer.astro';
---
<Experience
  title="Verk — Infraestructura Digital"
  description="Verk construye los sistemas digitales que conectan tu presencia online con tu operación real. Sitios, automatizaciones, integraciones CRM y herramientas con IA."
>
  <Header />
  <main class="page-grid" id="main">
    <Hero />
    <Services />
    <Method />
    <Systems />
    <Contact />
    <Footer />
  </main>
</Experience>
