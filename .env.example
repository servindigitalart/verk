# Verk — environment variable reference.
# Copy to `.env` for local development. Real values also need to be set in
# Netlify: Site configuration → Environment variables.
# This file must never contain real secrets — placeholders only.

# ── Site ──────────────────────────────────────────────────────
# Canonical production URL. Used for OG/canonical/sitemap URL generation.
PUBLIC_SITE_URL=https://verk.mx

# ── Supabase (future: CRM/lead storage) ─────────────────────────
# Safe to expose client-side (PUBLIC_ prefix required by Astro).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# ── Stripe (future: payments/invoicing) ─────────────────────────
# Server-only. Never prefix with PUBLIC_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Resend (future: transactional email / contact form) ─────────
RESEND_API_KEY=

# ── AI providers ────────────────────────────────────────────────
# OPENAI_API_KEY is also used by the Instagram publisher (scripts/social).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ── Meta app ────────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=

# ── Instagram publisher (scripts/social, docs/26) ───────────────
# Secrets in GitHub: INSTAGRAM_ACCESS_TOKEN, OPENAI_API_KEY, GOOGLE_OAUTH_*.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=17841420522725752
META_GRAPH_API_VERSION=v26.0

# Google Drive storage (OAuth "Desktop app" client, scope drive.file).
# The refresh token comes from `node scripts/social/auth-google.mjs`.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Optional: folder created by the app. Empty = find or create "VERK Social".
DRIVE_ROOT_FOLDER_ID=

# OpenAI models (verified 2026-11-10; checked again at runtime via /v1/models/{id}).
IMAGE_MODEL=gpt-image-2.6-sunburst
TEXT_MODEL=gpt-6.1-sol
VISION_MODEL=gpt-6.1-terra

# Master switch. Anything other than "true" means nothing is generated or
# published on scheduled runs.
SOCIAL_ENABLED=false
